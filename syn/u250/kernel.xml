<?xml version="1.0" encoding="UTF-8"?>
<!--
  SK_afu 的 kernel.xml：把 rtl/top/SK_afu.sv 的控制寄存器和端口告诉 v++，
  寄存器表和 docs/design.md §5.6 一致。

  - s_axi_control：4 KB、32-bit AXI-Lite；参数从 0x10 起，和 Vitis RTL kernel 的
    ap_ctrl 约定对齐（0x00 CTRL / 0x04 GIE / 0x08 IER / 0x0C ISR）。
  - m_axi_gmem：512-bit AXI4 主口，核一次搬一整行 64 B。
  只读寄存器（STATUS 0x44 / SHAPE 0x48 / DBG_DATA 0x54）不列进 args，
  主机用 read_register 直接读。
-->
<root versionMajor="1" versionMinor="6">
  <kernel name="SK_afu" language="ip_c" vlnv="skein.com:kernel:SK_afu:1.0"
          attributes="" preferredWorkGroupSizeMultiple="0" workGroupSize="1"
          interrupt="false" hwControlProtocol="ap_ctrl_hs">
    <ports>
      <port name="s_axi_control" mode="slave" range="0x1000" dataWidth="32"
            portType="addressable" base="0x0"/>
      <port name="m_axi_gmem" mode="master" range="0xFFFFFFFFFFFFFFFF" dataWidth="512"
            portType="addressable" base="0x0"/>
    </ports>
    <args>
      <arg name="grid_dim"    addressQualifier="0" id="0"  port="s_axi_control" size="0x4" offset="0x010" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="block_dim"   addressQualifier="0" id="1"  port="s_axi_control" size="0x4" offset="0x014" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="ptr_a"       addressQualifier="0" id="2"  port="s_axi_control" size="0x4" offset="0x018" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="ptr_b"       addressQualifier="0" id="3"  port="s_axi_control" size="0x4" offset="0x01C" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="ptr_c"       addressQualifier="0" id="4"  port="s_axi_control" size="0x4" offset="0x020" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="arg0"        addressQualifier="0" id="5"  port="s_axi_control" size="0x4" offset="0x024" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="arg1"        addressQualifier="0" id="6"  port="s_axi_control" size="0x4" offset="0x028" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="arg2"        addressQualifier="0" id="7"  port="s_axi_control" size="0x4" offset="0x02C" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <!-- gmem_base 是 BO 的设备地址：声明成指向 m_axi_gmem 的指针参数，
           v++ 才会给这个 master 建 function map（主机不通过 krnl(...) 传参，
           仍然用 write_register 写 0x30/0x34） -->
      <arg name="gmem_base"   addressQualifier="1" id="8"  port="m_axi_gmem" size="0x8" offset="0x030" hostOffset="0x0" hostSize="0x8" type="int*"/>
      <arg name="imem_addr"   addressQualifier="0" id="9"  port="s_axi_control" size="0x4" offset="0x038" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="imem_wdata"  addressQualifier="0" id="10" port="s_axi_control" size="0x4" offset="0x03C" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="imem_we"     addressQualifier="0" id="11" port="s_axi_control" size="0x4" offset="0x040" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="dbg_addr"    addressQualifier="0" id="12" port="s_axi_control" size="0x4" offset="0x04C" hostOffset="0x0" hostSize="0x4" type="uint"/>
      <arg name="dbg_sel"     addressQualifier="0" id="13" port="s_axi_control" size="0x4" offset="0x050" hostOffset="0x0" hostSize="0x4" type="uint"/>
    </args>
  </kernel>
</root>
